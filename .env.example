# Reference only — Vercel stores env vars in Project → Settings → Environment
# Variables. Copy to a local `.env` only for `vercel dev` / local scripts.
#
# Yoco CHEAT SHEET:
#   - SECRET key starts with sk_ (sk_test_... / sk_live_...). This is what
#     YOCO_SECRET_KEY below must hold — api/create-checkout.js uses it as the
#     Bearer token to create checkouts server-side.
#   - PUBLISHABLE key starts with pk_ (e.g. pk_live_...). It is for the browser
#     only and does NOT authorize API calls — do NOT put it here as the secret.
#   - Find both under: Yoco dashboard → Settings → API keys.
YOCO_SECRET_KEY="sk_test_your_key_here"

# Bob Go (courier tracking proxy). BOBGO_BASE_URL defaults to sandbox; switch to
# https://api.bobgo.co.za/v2 for production with a live key.
BOBGO_API_KEY="your_bobgo_api_key"
BOBGO_BASE_URL="https://api.sandbox.bobgo.co.za/v2"